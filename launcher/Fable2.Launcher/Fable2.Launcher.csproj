<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Fable2Launcher</AssemblyName>
    <AssemblyTitle>Project Sparrow</AssemblyTitle>
    <Product>Project Sparrow</Product>
    <ApplicationIcon>..\..\assets\app-icon.ico</ApplicationIcon>
    <RootNamespace>Fable2Launcher</RootNamespace>
    <!-- Program.Main runs Velopack before WPF starts. -->
    <StartupObject>Fable2Launcher.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\constants\GameVersions.cs" Link="Constants\GameVersions.cs" />
    <!-- Disc reference lists for "Check game files" (made with x360extract, manifest option). -->
    <EmbeddedResource Include="..\..\constants\disc-manifests\*.txt" LogicalName="DiscManifests/%(Filename)%(Extension)" />
    <!-- Reusable Xbox 360 disc reader/extractor (GDFX + ISO 9660 + STFS), shared
         with tools/x360extract. Consumed as a project reference; produces X360ExtractCore.dll. -->
    <ProjectReference Include="..\..\tools\x360extract\lib\X360Extract.Core.csproj" />
    <Resource Include="..\..\assets\app-icon.png" Link="Assets\app-icon.png" />
    <!-- IM FELL English and Alegreya Sans, SIL Open Font License (Fonts/OFL-*.txt). -->
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
