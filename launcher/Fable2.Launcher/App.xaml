<Application x:Class="Fable2Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Global styles. The window's own design styles live in MainWindow.xaml. -->
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Alegreya Sans" />
    </Style>

    <!-- Dropdowns use dark text on a light parchment background, including the
         selected item (tested in tests/Fable2.Launcher.ConfigTests). -->
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="190" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontFamily" Value="pack://application:,,,/Fonts/#Alegreya Sans" />
      <Setter Property="Foreground" Value="#FF172020" />
      <Setter Property="Background" Value="#FFF3EEE4" />
      <Setter Property="BorderBrush" Value="#FFBFAE80" />
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#FF172020" />
      <Setter Property="Background" Value="#FFF3EEE4" />
      <Setter Property="Padding" Value="10,7" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#FFE4C982" />
          <Setter Property="Foreground" Value="#FF17130B" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#FFC69A46" />
          <Setter Property="Foreground" Value="#FF17130B" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
