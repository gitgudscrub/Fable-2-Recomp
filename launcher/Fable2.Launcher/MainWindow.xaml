<Window x:Class="Fable2Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Sparrow" Width="1180" Height="740" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Night}"
        Icon="pack://application:,,,/Assets/app-icon.png"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <!-- Design: launcher/design/mockup.html. The window is a storybook scene: centred
       title, gold seal to play, edition ribbon, and a parchment page that turns in
       from the right edge for settings and help. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="Night" Color="#FF07140E" />
    <SolidColorBrush x:Key="MossLine" Color="#FF2A4D3E" />
    <SolidColorBrush x:Key="Gold" Color="#FFD6B25E" />
    <SolidColorBrush x:Key="GoldHi" Color="#FFF1D98F" />
    <SolidColorBrush x:Key="GoldDeep" Color="#FF8A6420" />
    <SolidColorBrush x:Key="GoldInk" Color="#FF1D1405" />
    <SolidColorBrush x:Key="Ivory" Color="#FFEFE5C9" />
    <SolidColorBrush x:Key="Sage" Color="#FFA9BCA9" />
    <SolidColorBrush x:Key="SageDim" Color="#FF7A947F" />
    <SolidColorBrush x:Key="Ember" Color="#FFE6955A" />
    <SolidColorBrush x:Key="Page" Color="#FFEFE4C6" />
    <SolidColorBrush x:Key="Ink" Color="#FF2B2414" />
    <SolidColorBrush x:Key="InkSoft" Color="#FF6A5C3D" />
    <SolidColorBrush x:Key="InkGreen" Color="#FF1F4A37" />
    <SolidColorBrush x:Key="Rule" Color="#FFD3C392" />
    <!-- Theme brushes: Dusk values here; Themes.cs replaces them for Night and Day. -->
    <SolidColorBrush x:Key="TitleBar" Color="#FF0A1A13" />
    <SolidColorBrush x:Key="Pill" Color="#99071410" />
    <SolidColorBrush x:Key="Well" Color="#CC071410" />
    <SolidColorBrush x:Key="EdBg" Color="#B3071410" />
    <SolidColorBrush x:Key="GoldLine" Color="#73D6B25E" />
    <SolidColorBrush x:Key="GoldLineSoft" Color="#40D6B25E" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#73030A07" />
    <SolidColorBrush x:Key="Hill1" Color="#FF163A2B" />
    <SolidColorBrush x:Key="Tower" Color="#FF122F23" />
    <SolidColorBrush x:Key="Hill2" Color="#FF0F2A1F" />
    <SolidColorBrush x:Key="Hill3" Color="#FF0A1D16" />
    <SolidColorBrush x:Key="Moon" Color="#D9EFE5C9" />
    <SolidColorBrush x:Key="PageLine" Color="#FFD9C99F" />
    <SolidColorBrush x:Key="CtlLine" Color="#FFBFAE80" />
    <SolidColorBrush x:Key="WellPage" Color="#FFF6EED6" />
    <SolidColorBrush x:Key="SwOff" Color="#FFE2D4AD" />
    <SolidColorBrush x:Key="KnobOff" Color="#FFA99868" />
    <SolidColorBrush x:Key="OnBg" Color="#FF1F4A37" />
    <SolidColorBrush x:Key="OnText" Color="#FFEFE4C6" />
    <SolidColorBrush x:Key="KnobOn" Color="#FFF1D98F" />
    <SolidColorBrush x:Key="TabOnText" Color="#FF1F4A37" />
    <SolidColorBrush x:Key="KeyListen" Color="#FFE4EFE4" />
    <LinearGradientBrush x:Key="SkyBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF05110C" Offset="0" />
      <GradientStop Color="#FF0D281D" Offset="0.5" />
      <GradientStop Color="#FF1C4130" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="GlowBrush" Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.5" RadiusY="0.5">
      <GradientStop Color="#38F1D98F" Offset="0" />
      <GradientStop Color="#00F1D98F" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="VignetteBrush" Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.62" RadiusY="0.62">
      <GradientStop Color="#00040C08" Offset="0" />
      <GradientStop Color="#8C040C08" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="RibbonBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#00050E0A" Offset="0" />
      <GradientStop Color="#D9050E0A" Offset="0.45" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SheetBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FFE4D6B0" Offset="0" />
      <GradientStop Color="#FFEFE4C6" Offset="0.04" />
      <GradientStop Color="#FFEFE4C6" Offset="0.97" />
      <GradientStop Color="#FFDCCDA4" Offset="0.975" />
      <GradientStop Color="#FFE9DCBA" Offset="0.985" />
      <GradientStop Color="#FFD6C597" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFF1D98F" Offset="0" />
      <GradientStop Color="#FFC99A3C" Offset="1" />
    </LinearGradientBrush>
    <FontFamily x:Key="Display">pack://application:,,,/Fonts/#IM FELL English</FontFamily>
    <FontFamily x:Key="DisplaySC">pack://application:,,,/Fonts/#IM FELL English SC</FontFamily>
    <FontFamily x:Key="Body">pack://application:,,,/Fonts/#Alegreya Sans</FontFamily>

    <!-- Title bar buttons -->
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Foreground" Value="{DynamicResource Sage}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#22F1D98F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#FFB3392F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Corner tools on the scene (Settings, Help) -->
    <Style x:Key="ToolPill" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ivory}" />
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{DynamicResource Pill}" BorderBrush="{DynamicResource GoldLine}" BorderThickness="1"
                    CornerRadius="17" Padding="12,6,16,6">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GoldHi}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GoldHi}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The gold seal -->
    <Style x:Key="Seal" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="152" />
      <Setter Property="Height" Value="152" />
      <Setter Property="Foreground" Value="{StaticResource GoldInk}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse Margin="-8" Stroke="#59F1D98F" StrokeThickness="1" Fill="#26D6B25E" />
              <Ellipse x:Name="Disc">
                <Ellipse.Fill>
                  <RadialGradientBrush GradientOrigin="0.38,0.32" Center="0.45,0.4" RadiusX="0.62" RadiusY="0.62">
                    <GradientStop Color="#FFFBEAB4" Offset="0" />
                    <GradientStop Color="#FFE3BF68" Offset="0.38" />
                    <GradientStop Color="#FFA87A2C" Offset="0.8" />
                    <GradientStop Color="#FF7A5418" Offset="1" />
                  </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                  <DropShadowEffect Color="#FFF1D98F" BlurRadius="46" ShadowDepth="0" Opacity="0.55" />
                </Ellipse.Effect>
              </Ellipse>
              <Ellipse Margin="11" Stroke="#73462D0A" StrokeThickness="1.5" StrokeDashArray="3 2.5" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Disc" Property="Opacity" Value="0.92" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Disc" Property="Opacity" Value="0.7" />
                <Setter Property="Cursor" Value="Wait" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource Ivory}" />
                <Setter TargetName="Disc" Property="StrokeThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small buttons on the dark scene (extraction prompt) -->
    <Style x:Key="SceneButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ivory}" />
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{DynamicResource Well}" BorderBrush="{DynamicResource MossLine}"
                    BorderThickness="1" CornerRadius="6" Padding="14,6">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Gold}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Edition ribbon choices -->
    <Style x:Key="EditionChoice" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Edition" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" Background="Transparent" Padding="18,8,22,9" MinWidth="150">
              <StackPanel>
                <TextBlock x:Name="Title" Text="{TemplateBinding Content}" FontFamily="{StaticResource Display}"
                           FontSize="19" Foreground="{DynamicResource Ivory}" />
                <TextBlock x:Name="Sub" Text="{TemplateBinding Tag}" FontSize="13"
                           Foreground="{DynamicResource SageDim}" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource GoldFill}" />
                <Setter TargetName="Title" Property="Foreground" Value="{StaticResource GoldInk}" />
                <Setter TargetName="Sub" Property="Foreground" Value="#FF3D2D0F" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Bg" Property="Background" Value="#22F1D98F" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Bookmark tabs on the parchment page -->
    <Style x:Key="Bookmark" TargetType="RadioButton">
      <Setter Property="GroupName" Value="PageTabs" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" Background="{DynamicResource GoldDeep}" CornerRadius="6,0,0,6"
                    Padding="8,14" Width="34">
              <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="200" Opacity="0.3" />
              </Border.Effect>
              <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="13" FontWeight="Bold"
                         Foreground="{DynamicResource Page}" HorizontalAlignment="Center">
                <TextBlock.LayoutTransform>
                  <RotateTransform Angle="-90" />
                </TextBlock.LayoutTransform>
              </TextBlock>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Page}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TabOnText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Parchment page pieces -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}" />
      <Setter Property="FontSize" Value="32" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style x:Key="PageSection" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource GoldDeep}" />
      <Setter Property="Margin" Value="0,20,0,2" />
    </Style>
    <Style x:Key="PageText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PageHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Row" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,9" />
      <Setter Property="MinHeight" Value="48" />
    </Style>

    <Style x:Key="PageLink" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" BorderBrush="{DynamicResource Rule}"
                    BorderThickness="0,0,0,1" Padding="0,11">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter />
                <TextBlock Grid.Column="1" Text="›" FontSize="22" Foreground="{DynamicResource GoldDeep}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource InkGreen}" />
                <Setter TargetName="Bg" Property="Background" Value="#14000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PageButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="{DynamicResource WellPage}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtlLine}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14,6">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PageButtonGreen" TargetType="Button" BasedOn="{StaticResource PageButton}">
      <Setter Property="Foreground" Value="{DynamicResource OnText}" />
      <Setter Property="Background" Value="{DynamicResource OnBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OnBg}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="CloseLink" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" BorderBrush="{DynamicResource PageLine}" BorderThickness="1" CornerRadius="12" Padding="12,3"
                    Background="Transparent">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GoldDeep}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch for the parchment page -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource SwOff}"
                    BorderBrush="{DynamicResource CtlLine}" BorderThickness="1">
              <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource KnobOff}" HorizontalAlignment="Left"
                       Margin="3,0,0,0" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource OnBg}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource OnBg}" />
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource KnobOn}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource GoldDeep}" />
                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChannelChoice" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Channel" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" Background="Transparent" Padding="16,6">
              <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="14"
                         Foreground="{DynamicResource InkSoft}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource OnBg}" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource OnText}" />
                <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Dropdowns follow the theme. The stock template ignores Background, so this
         replaces it; sizes and fonts still come from App.xaml. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource WellPage}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtlLine}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box" CornerRadius="6" BorderThickness="1"
                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                            Data="M0,0 L4.5,4.5 L9,0" StrokeThickness="1.5" Stroke="{DynamicResource GoldDeep}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GoldDeep}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Margin="0,2,0,0" CornerRadius="6" BorderThickness="1" Padding="0,4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{DynamicResource WellPage}" BorderBrush="{DynamicResource CtlLine}">
                  <ScrollViewer>
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GoldDeep}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Theme quick-switch button: Content is the icon's path data (24x24). -->
    <Style x:Key="QuickTheme" TargetType="RadioButton">
      <Setter Property="GroupName" Value="QuickTheme" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Sage}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" Width="34" Height="28" CornerRadius="14" Background="Transparent">
              <Viewbox Width="17" Height="17">
                <Canvas Width="24" Height="24">
                  <Path x:Name="Icon" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                        Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Canvas>
              </Viewbox>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GoldHi}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GoldHi}" />
                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Gold}" />
                <Setter Property="Foreground" Value="{DynamicResource Night}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ThinBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border CornerRadius="3" Background="{DynamicResource Well}" BorderBrush="{DynamicResource MossLine}" BorderThickness="1">
              <Grid x:Name="PART_Track">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#FFD6B25E" Offset="0" />
                      <GradientStop Color="#FFF1D98F" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sliders, text boxes and scroll bars follow the theme (the Windows defaults
         stay light on the Night page). -->
    <Style x:Key="SliderPart" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent">
              <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource SwOff}" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SliderPart}" Command="Slider.DecreaseLarge"
                                Background="{DynamicResource OnBg}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SliderPart}" Command="Slider.IncreaseLarge" Background="Transparent" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource WellPage}"
                                 Stroke="{DynamicResource OnBg}" StrokeThickness="2" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnBg}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PageTextBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource WellPage}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CtlLine}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource OnBg}" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Box" CornerRadius="5" BorderThickness="1" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                            VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource OnBg}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollPart" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Bar" CornerRadius="4" Background="{DynamicResource CtlLine}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource KnobOff}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource KnobOff}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="Transparent" Padding="2,2">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPart}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPart}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Height" Value="10" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Border Background="Transparent" Padding="2,2">
                  <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPart}" Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPart}" Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                  </Track>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Storyboard x:Key="Fireflies" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="Flies" Storyboard.TargetProperty="Opacity"
                       From="0.35" To="1" Duration="0:0:3" />
      <DoubleAnimation Storyboard.TargetName="FliesShift" Storyboard.TargetProperty="Y"
                       From="0" To="-14" Duration="0:0:6" />
      <DoubleAnimation Storyboard.TargetName="FliesShift" Storyboard.TargetProperty="X"
                       From="0" To="10" Duration="0:0:6" />
      <DoubleAnimation Storyboard.TargetName="BirdsShift" Storyboard.TargetProperty="X"
                       From="0" To="40" Duration="0:0:9" />
      <DoubleAnimation Storyboard.TargetName="BirdsShift" Storyboard.TargetProperty="Y"
                       From="0" To="-12" Duration="0:0:9" />
    </Storyboard>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Grid Background="{DynamicResource TitleBar}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
        <Image Source="pack://application:,,,/Assets/app-icon.png" Width="18" Height="18">
          <Image.Clip>
            <RectangleGeometry Rect="0,0,18,18" RadiusX="4" RadiusY="4" />
          </Image.Clip>
        </Image>
        <TextBlock Text="Project Sparrow" Margin="10,0,0,0" FontSize="14" Foreground="{DynamicResource Sage}"
                   VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource ChromeButton}" Click="MinimizeClicked" ToolTip="Minimise">
          <Path Data="M0,0 L10,0" Stroke="{DynamicResource Sage}" StrokeThickness="1" />
        </Button>
        <Button Style="{StaticResource ChromeButton}" Click="MaximizeClicked" ToolTip="Maximise">
          <Rectangle Width="10" Height="10" Stroke="{DynamicResource Sage}" StrokeThickness="1" />
        </Button>
        <Button Style="{StaticResource CloseButton}" Click="CloseClicked" ToolTip="Close">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource Sage}" StrokeThickness="1" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Stage -->
    <Grid x:Name="Stage" Grid.Row="1" ClipToBounds="True">
      <!-- Scene art (all drawn here, no game artwork) -->
      <Viewbox Stretch="UniformToFill">
        <Canvas Width="1180" Height="700">
          <Rectangle Width="1180" Height="700" Fill="{DynamicResource SkyBrush}" />
          <Rectangle Width="1180" Height="700" Fill="{DynamicResource GlowBrush}" />
          <Path x:Name="Stars" Fill="#FFF1D98F" Data="M90,70 m-1.4,0 a1.4,1.4 0 1 0 2.8,0 a1.4,1.4 0 1 0 -2.8,0
                M240,40 m-1,0 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0
                M360,120 m-1.6,0 a1.6,1.6 0 1 0 3.2,0 a1.6,1.6 0 1 0 -3.2,0
                M820,60 m-1.1,0 a1.1,1.1 0 1 0 2.2,0 a1.1,1.1 0 1 0 -2.2,0
                M930,140 m-1,0 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0
                M1060,50 m-1.5,0 a1.5,1.5 0 1 0 3,0 a1.5,1.5 0 1 0 -3,0
                M170,200 m-1,0 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0
                M1010,230 m-1,0 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0
                M700,30 m-1.2,0 a1.2,1.2 0 1 0 2.4,0 a1.2,1.2 0 1 0 -2.4,0
                M470,60 m-1,0 a1,1 0 1 0 2,0 a1,1 0 1 0 -2,0
                M1120,300 m-1.1,0 a1.1,1.1 0 1 0 2.2,0 a1.1,1.1 0 1 0 -2.2,0" Opacity="0.8" />
          <Path x:Name="MoonShape" Fill="{DynamicResource Moon}" Data="M1000,110 a34,34 0 1 0 28,52 a27,27 0 1 1 -28,-52 z" />
          <Canvas x:Name="Sun" Visibility="Collapsed">
            <Ellipse Canvas.Left="932" Canvas.Top="62" Width="156" Height="156" Fill="#80FFF3C4" />
            <Ellipse Canvas.Left="968" Canvas.Top="98" Width="84" Height="84" Fill="#FFF4D27A" />
          </Canvas>
          <Path Fill="{DynamicResource Hill1}" Data="M0,500 C160,450 300,462 440,485 S760,440 900,470 S1100,455 1180,462 V700 H0 Z" />
          <Path Fill="{DynamicResource Tower}" Data="M160,382 h18 v96 h-18 z M155,384 L169,348 L183,384 Z M960,482 q30,-70 60,0 z M990,480 q26,-96 52,0 z" />
          <Rectangle x:Name="Lamp" Canvas.Left="166" Canvas.Top="402" Width="6" Height="9" Fill="#E6F1D98F" />
          <Path Fill="{DynamicResource Hill2}" Data="M0,550 C200,510 380,522 560,542 S900,518 1180,536 V700 H0 Z" />
          <Path Fill="{DynamicResource Hill3}" Data="M0,610 C260,578 480,588 700,604 S1020,590 1180,598 V700 H0 Z" />
          <Canvas x:Name="Flies">
            <Canvas.RenderTransform>
              <TranslateTransform x:Name="FliesShift" />
            </Canvas.RenderTransform>
            <Ellipse Canvas.Left="298" Canvas.Top="548" Width="4" Height="4" Fill="#FFF1D98F" />
            <Ellipse Canvas.Left="858" Canvas.Top="528" Width="3.2" Height="3.2" Fill="#FFF1D98F" />
            <Ellipse Canvas.Left="518" Canvas.Top="588" Width="3.6" Height="3.6" Fill="#FFF1D98F" />
            <Ellipse Canvas.Left="1038" Canvas.Top="568" Width="3" Height="3" Fill="#FFF1D98F" />
            <Ellipse Canvas.Left="138" Canvas.Top="588" Width="2.8" Height="2.8" Fill="#FFF1D98F" />
          </Canvas>
          <!-- Day only: sparrows instead of fireflies -->
          <Canvas x:Name="Birds" Visibility="Collapsed">
            <Canvas.RenderTransform>
              <TranslateTransform x:Name="BirdsShift" />
            </Canvas.RenderTransform>
            <Path Stroke="#FF3F4D36" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M300,150 q8,-8 16,0 q8,-8 16,0 M350,186 q6,-6 12,0 q6,-6 12,0 M760,118 q7,-7 14,0 q7,-7 14,0" />
          </Canvas>
        </Canvas>
      </Viewbox>
      <Rectangle IsHitTestVisible="False" Fill="{DynamicResource VignetteBrush}" />

      <!-- Centre and ribbon -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="CentreStack" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40,24,12">
          <Image Source="pack://application:,,,/Assets/app-icon.png" Width="92" Height="92" HorizontalAlignment="Center">
            <Image.Clip>
              <RectangleGeometry Rect="0,0,92,92" RadiusX="22" RadiusY="22" />
            </Image.Clip>
            <Image.Effect>
              <DropShadowEffect Color="#FFF1D98F" BlurRadius="40" ShadowDepth="0" Opacity="0.4" />
            </Image.Effect>
          </Image>
          <TextBlock Text="FABLE II  ·  RECOMPILED FOR WINDOWS" HorizontalAlignment="Center" Margin="0,14,0,0"
                     FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Gold}" />
          <TextBlock Text="P R O J E C T" HorizontalAlignment="Center" Margin="0,10,0,0"
                     FontFamily="{StaticResource DisplaySC}" FontSize="24" Foreground="{DynamicResource Gold}" />
          <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource Display}" FontSize="82"
                     Foreground="{DynamicResource Ivory}" Margin="0,-10,0,0">
            <TextBlock.Effect>
              <DropShadowEffect ShadowDepth="3" Direction="270" BlurRadius="0" Opacity="0.35" />
            </TextBlock.Effect>
            <Run Text="S" Foreground="{DynamicResource GoldHi}" /><Run Text="parrow" />
          </TextBlock>
          <Path HorizontalAlignment="Center" Margin="0,2,0,4" Fill="{DynamicResource Gold}" Stroke="{DynamicResource Gold}"
                StrokeThickness="1" Data="M0,7 H130 M190,7 H320 M160,1 L166,7 L160,13 L154,7 Z M138,7 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M178,7 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0" />
          <TextBlock Text="Every hero begins as a sparrow." HorizontalAlignment="Center" FontFamily="{StaticResource Display}"
                     FontStyle="Italic" FontSize="19" Foreground="{DynamicResource Sage}" />

          <Button x:Name="SealButton" Style="{StaticResource Seal}" AutomationProperties.Name="Play" Margin="0,30,0,0" Click="SealClicked">
            <StackPanel>
              <TextBlock x:Name="SealText" Text="Play" HorizontalAlignment="Center" FontFamily="{StaticResource DisplaySC}"
                         FontSize="30" Foreground="{StaticResource GoldInk}" />
              <TextBlock x:Name="SealSubText" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"
                         Foreground="#BF1D1405" Visibility="Collapsed" />
            </StackPanel>
          </Button>

          <StackPanel MaxWidth="580" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource Gold}" VerticalAlignment="Center">
                <Ellipse.Effect>
                  <DropShadowEffect Color="#FFD6B25E" BlurRadius="10" ShadowDepth="0" />
                </Ellipse.Effect>
              </Ellipse>
              <TextBlock x:Name="StatusTitle" Text="Ready to play" Margin="10,0,0,0" FontSize="18" FontWeight="Bold"
                         Foreground="{DynamicResource Ivory}" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,4,0,0" FontSize="15.5" Foreground="{DynamicResource Sage}"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <ProgressBar x:Name="ExtractBar" Style="{StaticResource ThinBar}" Maximum="100" Width="360"
                         Margin="0,10,0,0" Visibility="Collapsed" />
            <StackPanel x:Name="ExtractActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                        Visibility="Collapsed">
              <Button x:Name="ExtractAnywayButton" Style="{StaticResource SceneButton}" Content="Copy it anyway"
                      Click="ExtractAnywayClicked" Visibility="Collapsed" />
              <Button x:Name="StopButton" Style="{StaticResource SceneButton}" Content="Stop" Click="StopClicked" />
            </StackPanel>
            <Button x:Name="PlayWithoutUpdateButton" Style="{StaticResource SceneButton}" HorizontalAlignment="Center"
                    Margin="0,12,0,0" Content="Play now, update later" Click="PlayWithoutUpdateClicked"
                    Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>

        <!-- Edition ribbon -->
        <Border Grid.Row="1" Padding="20,14,20,18" Background="{DynamicResource RibbonBrush}">
          <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <TextBlock Text="EDITION" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Gold}"
                         VerticalAlignment="Center" Margin="0,0,16,0" />
              <Border BorderBrush="{DynamicResource GoldLine}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource EdBg}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="EditionOriginal" Style="{StaticResource EditionChoice}" Content="Original"
                               Tag="30 fps · 720p · as on Xbox" Checked="EditionChecked" />
                  <Rectangle Width="1" Fill="{DynamicResource GoldLineSoft}" />
                  <RadioButton x:Name="EditionEnhanced" Style="{StaticResource EditionChoice}" Content="Enhanced"
                               Tag="60 fps · 1440p · FXAA" Checked="EditionChecked" />
                  <Rectangle Width="1" Fill="{DynamicResource GoldLineSoft}" />
                  <RadioButton x:Name="EditionExperimental" Style="{StaticResource EditionChoice}" Content="Experimental"
                               Tag="Uncapped · 4x scale · may glitch" Checked="EditionChecked" />
                </StackPanel>
              </Border>
              <TextBlock x:Name="CustomMarker" Text="Custom changes" FontSize="13.5" Foreground="{StaticResource Ember}"
                         VerticalAlignment="Center" Margin="16,0,0,0" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="13"
                       Foreground="{DynamicResource SageDim}" />
          </Grid>
        </Border>
      </Grid>

      <!-- Theme quick switch -->
      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14,0,0" Padding="3" CornerRadius="17"
              Background="{DynamicResource Pill}" BorderBrush="{DynamicResource GoldLine}" BorderThickness="1">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="QuickNight" Style="{StaticResource QuickTheme}" Tag="night" ToolTip="Night"
                       AutomationProperties.Name="Night theme" Checked="ThemeChecked"
                       Content="M20,14.5 A8,8 0 0 1 9.5,4 A8,8 0 1 0 20,14.5 Z M17,3 V6 M15.5,4.5 H18.5" />
          <RadioButton x:Name="QuickDusk" Style="{StaticResource QuickTheme}" Tag="dusk" ToolTip="Dusk"
                       AutomationProperties.Name="Dusk theme" Checked="ThemeChecked"
                       Content="M6,17 A6,6 0 0 1 18,17 M2,17 H22 M5,21 H19 M12,5 V8 M4.6,9.6 L6.6,11.6 M19.4,9.6 L17.4,11.6" />
          <RadioButton x:Name="QuickDay" Style="{StaticResource QuickTheme}" Tag="day" ToolTip="Day"
                       AutomationProperties.Name="Day theme" Checked="ThemeChecked"
                       Content="M8,12 A4,4 0 1 0 16,12 A4,4 0 1 0 8,12 M12,2 V4.5 M12,19.5 V22 M2,12 H4.5 M19.5,12 H22 M4.9,4.9 L6.7,6.7 M17.3,17.3 L19.1,19.1 M4.9,19.1 L6.7,17.3 M17.3,6.7 L19.1,4.9" />
        </StackPanel>
      </Border>

      <!-- Corner tools -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0">
        <Button Style="{StaticResource ToolPill}" Click="OpenSettingsClicked" AutomationProperties.Name="Settings">
          <StackPanel Orientation="Horizontal">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource GoldHi}" StrokeThickness="1.5"
                  Data="M12,9 a3,3 0 1 0 0.01,0 M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9" />
            <TextBlock Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource ToolPill}" Click="OpenHelpClicked" AutomationProperties.Name="Help">
          <StackPanel Orientation="Horizontal">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource GoldHi}" StrokeThickness="1.5"
                  Data="M12,3 a9,9 0 1 0 0.01,0 M9.5,9.5 a2.5,2.5 0 1 1 3.5,2.3 c-0.7,0.3 -1,0.9 -1,1.6 v0.6 M12,17 v0.5" />
            <TextBlock Text="Help" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Toast -->
      <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,96"
              Background="#FF0E2219" BorderBrush="{DynamicResource Gold}" BorderThickness="1" CornerRadius="8"
              Padding="16,10" Visibility="Collapsed" Panel.ZIndex="20" MaxWidth="640">
        <TextBlock x:Name="ToastText" FontSize="14.5" Foreground="{DynamicResource Ivory}" TextWrapping="Wrap" />
      </Border>

      <!-- Parchment page -->
      <Rectangle x:Name="Scrim" Fill="{DynamicResource ScrimBrush}" Visibility="Collapsed" MouseDown="ScrimMouseDown" Panel.ZIndex="10" />
      <Grid x:Name="PageHost" HorizontalAlignment="Right" Width="600" Visibility="Collapsed" Panel.ZIndex="11"
            RenderTransformOrigin="1,0.5">
        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="PageScale" ScaleX="1" />
            <SkewTransform x:Name="PageSkew" />
          </TransformGroup>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,70,-1,0">
          <RadioButton x:Name="TabSettings" Style="{StaticResource Bookmark}" Content="Settings" Checked="TabChecked" />
          <RadioButton x:Name="TabControls" Style="{StaticResource Bookmark}" Content="Controls" Checked="TabChecked" />
          <RadioButton x:Name="TabUpdates" Style="{StaticResource Bookmark}" Content="Updates" Checked="TabChecked" />
          <RadioButton x:Name="TabHelp" Style="{StaticResource Bookmark}" Content="Help" Checked="TabChecked" />
        </StackPanel>

        <Border Grid.Column="1" BorderBrush="{DynamicResource PageLine}" BorderThickness="1,0,0,0"
                Background="{DynamicResource SheetBrush}">
          <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" />
          </Border.Effect>
          <Grid>
            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Padding="30,24,34,30">
              <Grid x:Name="PageContent" RenderTransformOrigin="1,0.5">
                <Grid.RenderTransform>
                  <ScaleTransform x:Name="ContentScale" ScaleX="1" />
                </Grid.RenderTransform>

                <!-- Settings -->
                <StackPanel x:Name="PanelSettings">
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                    <Button Style="{StaticResource CloseLink}" Content="Close" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="ClosePageClicked" />
                  </Grid>
                  <TextBlock Text="APPEARANCE" Style="{StaticResource PageSection}" />
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource CtlLine}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton x:Name="ThemeNight" Style="{StaticResource ChannelChoice}" GroupName="PageTheme"
                                       Content="Night" Tag="night" Checked="ThemeChecked" />
                          <RadioButton x:Name="ThemeDusk" Style="{StaticResource ChannelChoice}" GroupName="PageTheme"
                                       Content="Dusk" Tag="dusk" Checked="ThemeChecked" />
                          <RadioButton x:Name="ThemeDay" Style="{StaticResource ChannelChoice}" GroupName="PageTheme"
                                       Content="Day" Tag="day" Checked="ThemeChecked" />
                        </StackPanel>
                      </Border>
                      <StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource PageText}" />
                        <TextBlock Text="Night is darkest, Day is light." Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <TextBlock Text="DISPLAY" Style="{StaticResource PageSection}" />
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <ComboBox x:Name="DisplayModeCombo" DockPanel.Dock="Right" SelectionChanged="SettingChanged">
                        <ComboBoxItem Tag="windowed">Windowed</ComboBoxItem>
                        <ComboBoxItem Tag="borderless">Borderless fullscreen</ComboBoxItem>
                        <ComboBoxItem Tag="exclusive">Exclusive fullscreen</ComboBoxItem>
                      </ComboBox>
                      <TextBlock Text="Window" Style="{StaticResource PageText}" />
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <ComboBox x:Name="ResolutionCombo" DockPanel.Dock="Right" SelectionChanged="SettingChanged">
                        <ComboBoxItem Tag="720p">1280 × 720</ComboBoxItem>
                        <ComboBoxItem Tag="1080p">1920 × 1080</ComboBoxItem>
                        <ComboBoxItem Tag="1440p">2560 × 1440</ComboBoxItem>
                        <ComboBoxItem Tag="4k">3840 × 2160</ComboBoxItem>
                      </ComboBox>
                      <TextBlock Text="Window size" Style="{StaticResource PageText}" />
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <ComboBox x:Name="RenderScaleCombo" DockPanel.Dock="Right" SelectionChanged="SettingChanged">
                        <ComboBoxItem Tag="1">1× (720p, original)</ComboBoxItem>
                        <ComboBoxItem Tag="2">2× (1440p)</ComboBoxItem>
                        <ComboBoxItem Tag="3">3× (4K)</ComboBoxItem>
                        <ComboBoxItem Tag="4">4× (5120 × 2880)</ComboBoxItem>
                      </ComboBox>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Render scale" Style="{StaticResource PageText}" />
                        <TextBlock Text="Draws the game sharper than the Xbox did" Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <ComboBox x:Name="AnisotropicCombo" DockPanel.Dock="Right" SelectionChanged="SettingChanged">
                        <ComboBoxItem Tag="-1">Game default</ComboBoxItem>
                        <ComboBoxItem Tag="1">1×</ComboBoxItem>
                        <ComboBoxItem Tag="2">2×</ComboBoxItem>
                        <ComboBoxItem Tag="3">4×</ComboBoxItem>
                        <ComboBoxItem Tag="4">8×</ComboBoxItem>
                        <ComboBoxItem Tag="5">16×</ComboBoxItem>
                      </ComboBox>
                      <TextBlock Text="Texture filtering" Style="{StaticResource PageText}" />
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <ComboBox x:Name="AntiAliasingCombo" DockPanel.Dock="Right" SelectionChanged="SettingChanged">
                        <ComboBoxItem Tag="none">Off (game's own)</ComboBoxItem>
                        <ComboBoxItem Tag="fxaa">FXAA</ComboBoxItem>
                        <ComboBoxItem Tag="fxaa_extreme">FXAA Extreme</ComboBoxItem>
                      </ComboBox>
                      <TextBlock Text="Smoothing" Style="{StaticResource PageText}" />
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <ComboBox x:Name="FrameLimitCombo" DockPanel.Dock="Right" SelectionChanged="SettingChanged" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Game frame rate" Style="{StaticResource PageText}" />
                        <TextBlock Text="Above 60 can break timing in some scenes" Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <ComboBox x:Name="HostFrameLimitCombo" DockPanel.Dock="Right" SelectionChanged="SettingChanged" />
                      <TextBlock Text="Display frame cap" Style="{StaticResource PageText}" />
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <CheckBox x:Name="VsyncCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                Checked="SettingChanged" Unchecked="SettingChanged" />
                      <TextBlock Text="VSync" Style="{StaticResource PageText}" />
                    </DockPanel>
                  </Border>

                  <TextBlock Text="MODERN TEXTURES" Style="{StaticResource PageSection}" />
                  <Border Padding="14,12" CornerRadius="6" Background="{DynamicResource WellPage}" BorderBrush="{DynamicResource PageLine}"
                          BorderThickness="1">
                    <StackPanel>
                      <TextBlock x:Name="TexturesStatusText" Style="{StaticResource PageText}" FontSize="14.5" />
                      <TextBlock x:Name="TexturesHintText" Style="{StaticResource PageHint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                      <UniformGrid x:Name="TexturesParts" Columns="2" Margin="0,8,0,0" Visibility="Collapsed" />
                      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="TexturesDownloadButton" Style="{StaticResource PageButtonGreen}" Content="Download"
                                Click="TexturesDownloadClicked" />
                        <Button x:Name="TexturesPauseButton" Style="{StaticResource PageButton}" Content="Pause"
                                Click="TexturesPauseClicked" Visibility="Collapsed" />
                        <Button x:Name="TexturesRemoveButton" Style="{StaticResource PageButton}" Content="Remove"
                                Click="TexturesRemoveClicked" Visibility="Collapsed" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="GAME" Style="{StaticResource PageSection}" />
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <CheckBox x:Name="SkipIntroCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                Checked="SettingChanged" Unchecked="SettingChanged" />
                      <TextBlock Text="Skip intro videos" Style="{StaticResource PageText}" />
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <CheckBox x:Name="MotionBlurCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                Checked="SettingChanged" Unchecked="SettingChanged" />
                      <TextBlock Text="Motion blur" Style="{StaticResource PageText}" />
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <CheckBox x:Name="UnlockWebsiteCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                Checked="SettingChanged" Unchecked="SettingChanged" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Website items" Style="{StaticResource PageText}" />
                        <TextBlock Text="Grants the old Fable II website rewards when a save loads" Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <CheckBox x:Name="UnlockCeCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                Checked="SettingChanged" Unchecked="SettingChanged" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Collector's Edition items" Style="{StaticResource PageText}" />
                        <TextBlock Text="Grants the Collector's Edition chest when a save loads" Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <TextBlock Text="EXPERIMENTAL" Style="{StaticResource PageSection}" />
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <CheckBox x:Name="HighTickCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                Checked="SettingChanged" Unchecked="HighTickUnchecked" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Faster world tick" Style="{StaticResource PageText}" />
                        <TextBlock Text="Runs the slow game tick at 30 Hz instead of 15. Unstable" Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <CheckBox x:Name="HigherHfTickCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                Checked="HigherHfTickChecked" Unchecked="SettingChanged" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Faster animation tick" Style="{StaticResource PageText}" />
                        <TextBlock Text="Runs the fast tick at 60 Hz instead of 30. Needs the faster world tick. Unstable" Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <CheckBox x:Name="MorphingCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                Checked="SettingChanged" Unchecked="SettingChanged" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Live skin changes" Style="{StaticResource PageText}" />
                        <TextBlock Text="Draws the hero and dog skin changes on the GPU. Fixes a black hero or dog" Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <CheckBox x:Name="ReadbackCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                Checked="SettingChanged" Unchecked="SettingChanged" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Old skin fix" Style="{StaticResource PageText}" />
                        <TextBlock Text="The earlier CPU fix for the hero and dog textures. Replaced by live skin changes" Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <TextBlock x:Name="YieldValueText" DockPanel.Dock="Right" Width="28" TextAlignment="Right"
                                 Style="{StaticResource PageText}" />
                      <Slider x:Name="YieldSlider" DockPanel.Dock="Right" Width="170" Minimum="0" Maximum="16"
                              IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                              ValueChanged="YieldChanged" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CPU yield batching" Style="{StaticResource PageText}" />
                        <TextBlock Text="1 is the original behaviour, 0 never yields" Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <TextBlock Text="Changes are saved when you close this page or press Play. Changing anything an edition sets marks it as Custom."
                             Style="{StaticResource PageHint}" Margin="0,14,0,0" />
                </StackPanel>

                <!-- Controls -->
                <StackPanel x:Name="PanelControls" Visibility="Collapsed">
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="Controls" Style="{StaticResource PageTitle}" />
                    <Button Style="{StaticResource CloseLink}" Content="Close" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="ClosePageClicked" />
                  </Grid>
                  <TextBlock Text="Controllers work straight away. These settings are for playing on keyboard and mouse."
                             Style="{StaticResource PageHint}" Margin="0,4,0,0" />
                  <TextBlock Text="MOUSE" Style="{StaticResource PageSection}" />
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <CheckBox x:Name="MouseLookCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                Checked="SettingChanged" Unchecked="SettingChanged" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mouse look" Style="{StaticResource PageText}" />
                        <TextBlock Text="Move the camera with the mouse" Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <CheckBox x:Name="DirectMouseCheck" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                Checked="SettingChanged" Unchecked="SettingChanged" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Direct camera" Style="{StaticResource PageText}" />
                        <TextBlock Text="Turns the camera like a PC game instead of through the right stick. Experimental" Style="{StaticResource PageHint}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <TextBox x:Name="SensitivityBox" DockPanel.Dock="Right" Width="56" Margin="10,0,0,0"
                               VerticalAlignment="Center" FontSize="14" Style="{StaticResource PageTextBox}"
                               LostFocus="SensitivityBoxLostFocus" KeyDown="SensitivityBoxKeyDown" />
                      <Slider x:Name="SensitivitySlider" DockPanel.Dock="Right" Width="200" Minimum="1" Maximum="4096"
                              VerticalAlignment="Center" ValueChanged="SensitivityChanged" />
                      <TextBlock Text="Mouse speed" Style="{StaticResource PageText}" />
                    </DockPanel>
                  </Border>
                  <Grid Margin="0,20,0,4">
                    <TextBlock Text="KEYBOARD KEYS" Style="{StaticResource PageSection}" Margin="0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Style="{StaticResource PageButton}" Content="Add a key" Click="AddKeybindClicked" />
                      <Button Style="{StaticResource PageButton}" Content="Reset to default" Margin="0" Click="ResetKeybindsClicked" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="Click a key box, then press the key or mouse button you want. Esc cancels."
                             Style="{StaticResource PageHint}" Margin="0,0,0,8" />
                  <StackPanel x:Name="KeybindList" />
                </StackPanel>

                <!-- Updates -->
                <StackPanel x:Name="PanelUpdates" Visibility="Collapsed">
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="Updates" Style="{StaticResource PageTitle}" />
                    <Button Style="{StaticResource CloseLink}" Content="Close" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="ClosePageClicked" />
                  </Grid>
                  <Border Style="{StaticResource Row}">
                    <DockPanel>
                      <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource CtlLine}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal">
                          <RadioButton x:Name="ChannelStable" Style="{StaticResource ChannelChoice}" Content="Stable"
                                       Checked="ChannelChecked" />
                          <RadioButton x:Name="ChannelBeta" Style="{StaticResource ChannelChoice}" Content="Beta"
                                       Checked="ChannelChecked" />
                        </StackPanel>
                      </Border>
                      <TextBlock Text="Channel" Style="{StaticResource PageText}" />
                    </DockPanel>
                  </Border>
                  <TextBlock x:Name="ChannelNote" Style="{StaticResource PageHint}" Margin="0,8,0,0" />
                  <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="6" Background="{DynamicResource WellPage}" BorderBrush="{DynamicResource PageLine}"
                          BorderThickness="1">
                    <StackPanel>
                      <TextBlock x:Name="UpdateStatusText" Style="{StaticResource PageText}" FontSize="14.5" />
                      <ProgressBar x:Name="UpdateBar" Style="{StaticResource ThinBar}" Maximum="100" Margin="0,10,0,0"
                                   Visibility="Collapsed" />
                      <StackPanel x:Name="UpdateActions" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                        <Button x:Name="CheckUpdatesButton" Style="{StaticResource PageButton}" Content="Check now"
                                Click="CheckUpdatesClicked" />
                        <Button x:Name="RestartUpdateButton" Style="{StaticResource PageButtonGreen}" Content="Restart to update"
                                Click="RestartToUpdateClicked" Visibility="Collapsed" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <TextBlock Style="{StaticResource PageHint}" Margin="0,10,0,0"
                             Text="Updates are signed by Project Sparrow and checked before they install. They never touch your saves, settings or game files." />
                </StackPanel>

                <!-- Help -->
                <StackPanel x:Name="PanelHelp" Visibility="Collapsed">
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="Help" Style="{StaticResource PageTitle}" />
                    <Button Style="{StaticResource CloseLink}" Content="Close" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="ClosePageClicked" />
                  </Grid>
                  <Button Style="{StaticResource PageLink}" Click="ReportToggleClicked">
                    <StackPanel>
                      <TextBlock Text="Report a problem" FontSize="16" />
                      <TextBlock Text="Bundle logs and settings, then open a GitHub issue" Style="{StaticResource PageHint}" />
                    </StackPanel>
                  </Button>
                  <Border x:Name="ReportPanel" Visibility="Collapsed" Margin="0,10,0,4" Padding="14,12" CornerRadius="6"
                          Background="{DynamicResource WellPage}" BorderBrush="{DynamicResource PageLine}" BorderThickness="1">
                    <StackPanel>
                      <TextBlock Style="{StaticResource PageHint}" FontSize="14.5"
                                 Text="This puts the following in one zip on your desktop. Nothing is uploaded; you attach it to the issue yourself." />
                      <TextBlock Style="{StaticResource PageHint}" FontSize="14.5" Margin="12,6,0,10"
                                 Text="• The last 3 game logs&#x0a;• Version, channel and edition&#x0a;• Your settings files (no saves)&#x0a;• Graphics card, driver and Windows version" />
                      <Button Style="{StaticResource PageButtonGreen}" Content="Create report" HorizontalAlignment="Left"
                              Click="CreateReportClicked" />
                    </StackPanel>
                  </Border>
                  <Button x:Name="CheckFilesButton" Style="{StaticResource PageLink}" Click="CheckFilesClicked">
                    <StackPanel>
                      <TextBlock Text="Check game files" FontSize="16" />
                      <TextBlock Text="Make sure every game file matches the original disc" Style="{StaticResource PageHint}" />
                    </StackPanel>
                  </Button>
                  <Border x:Name="CheckPanel" Visibility="Collapsed" Margin="0,10,0,4" Padding="14,12" CornerRadius="6"
                          Background="{DynamicResource WellPage}" BorderBrush="{DynamicResource PageLine}" BorderThickness="1">
                    <StackPanel>
                      <TextBlock x:Name="CheckStatusText" Style="{StaticResource PageText}" FontSize="14.5" TextWrapping="Wrap" />
                      <ProgressBar x:Name="CheckBar" Style="{StaticResource ThinBar}" Maximum="100" Margin="0,10,0,0" />
                      <TextBlock x:Name="CheckDetailText" Style="{StaticResource PageHint}" FontSize="14" Margin="0,8,0,0"
                                 TextWrapping="Wrap" Visibility="Collapsed" />
                      <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="CheckCancelButton" Style="{StaticResource PageButton}" Content="Stop"
                                Click="CheckCancelClicked" Margin="0,0,8,0" />
                        <Button x:Name="CheckRepairButton" Style="{StaticResource PageButtonGreen}" Content="Choose disc image…"
                                Click="CheckRepairClicked" Visibility="Collapsed" Margin="0,0,8,0" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Button Style="{StaticResource PageLink}" Click="OpenSavesClicked">
                    <TextBlock Text="Open save folder" FontSize="16" />
                  </Button>
                  <Button Style="{StaticResource PageLink}" Click="FolderToggleClicked">
                    <StackPanel>
                      <TextBlock Text="Change data folder" FontSize="16" />
                      <TextBlock x:Name="DataFolderHint" Style="{StaticResource PageHint}" />
                    </StackPanel>
                  </Button>
                  <Border x:Name="FolderPanel" Visibility="Collapsed" Margin="0,10,0,4" Padding="14,12" CornerRadius="6"
                          Background="{DynamicResource WellPage}" BorderBrush="{DynamicResource PageLine}" BorderThickness="1">
                    <StackPanel>
                      <TextBlock x:Name="FolderPanelText" Style="{StaticResource PageHint}" FontSize="14.5" Margin="0,0,0,10" />
                      <WrapPanel>
                        <Button x:Name="MoveDataButton" Style="{StaticResource PageButtonGreen}" Content="Move to…"
                                Click="MoveDataClicked" Margin="0,0,8,6" />
                        <Button Style="{StaticResource PageButton}" Content="Use game files from another folder…"
                                Click="UseGameFolderClicked" Margin="0,0,8,6" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Button Style="{StaticResource PageLink}" Click="ClearShaderCacheClicked">
                    <StackPanel>
                      <TextBlock Text="Clear shader cache" FontSize="16" />
                      <TextBlock Text="Try this if graphics look broken after an update" Style="{StaticResource PageHint}" />
                    </StackPanel>
                  </Button>
                  <TextBlock Style="{StaticResource PageHint}" Margin="0,22,0,0"
                             Text="Project Sparrow is an unofficial, fan-made recompilation of Fable II for Windows. You need your own Fable II Game of the Year disc; no game files are included or downloaded. Not affiliated with or endorsed by Microsoft or Xbox Game Studios. Built on the ReXGlue SDK. Fonts: IM FELL English and Alegreya Sans (SIL Open Font License)." />
                </StackPanel>
              </Grid>
            </ScrollViewer>
            <Rectangle x:Name="PageShade" IsHitTestVisible="False" Opacity="0">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                  <GradientStop Color="#593C280A" Offset="0" />
                  <GradientStop Color="#003C280A" Offset="0.4" />
                  <GradientStop Color="#40FFFAE6" Offset="0.85" />
                  <GradientStop Color="#333C280A" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
