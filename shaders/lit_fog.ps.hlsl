// Fable II lit surfaces in the sun with volume fog, pixel shader
// 999604E7F8EAE7CC: the Crucible's walls, the Temple of Shadows outside and
// Wraithmarsh ruins in the mist (one directional light c80 / c87 with the
// screen shadow tf8, then the fog volume marched through tf11 / tf12). Built
// only for Project Sparrow (tools/shaders/build_replace.py --sparrow).
//
// Stage 1: a literal port of the game's Xenos microcode, generated by
// tools/shaders/ucode_port.py (comments give the ucode instruction numbers;
// reading notes in xe_common.hlsli). Sparrow: the sun shadow map joins the
// game's shadow, sky light and bounce on the ambient, and GGX for the sun
// (SparrowLitSpecular).

#define XE_FLOAT_CONSTANTS 26
#define XE_DESCRIPTOR_INDICES 8
#include "xe_common.hlsli"
#if SPARROW
#include "sparrow_common.hlsli"
#endif
#define SPARROW_LIGHTS_DECL 7

#define C0 K[0]
#define C8 K[1]
#define C9 K[2]
#define C10 K[3]
#define C19 K[4]
#define C20 K[5]
#define C21 K[6]
#define C22 K[7]
#define C23 K[8]
#define C24 K[9]
#define C26 K[10]
#define C27 K[11]
#define C28 K[12]
#define C49 K[13]
#define C66 K[14]
#define C67 K[15]
#define C68 K[16]
#define C72 K[17]
#define C73 K[18]
#define C74 K[19]
#define C75 K[20]
#define C76 K[21]
#define C80 K[22]
#define C87 K[23]
#define C254 K[24]
#define C255 K[25]

// Texture bindings of this shader, in the translator's order.
#define TF2(uv) Fetch(2, 0, uv, false)
#define TF0(uv) Fetch(0, 1, uv, false)
#define TF1(uv) Fetch(1, 2, uv, false)
#define TF8(uv) Fetch(8, 3, uv, false)
#define TF13(uv) Fetch(13, 4, uv, false)
#define TF14(stf) FetchCube(14, 5, stf)
#define TF12(uv) Fetch(12, 6, uv, false)
#define TF11(uv) Fetch(11, 7, uv, false)
#define TF4(x) Fetch(4, 8, float2(x, 0.0), true)
#define TF5(x) Fetch(5, 9, float2(x, 0.0), true)

struct PSInputPort {
  float4 v0 : TEXCOORD0;
  float4 v1 : TEXCOORD1;
  float4 v2 : TEXCOORD2;
  float4 v3 : TEXCOORD3;
  float4 v4 : TEXCOORD4;
  float4 v5 : TEXCOORD5;
  centroid float4 v6 : TEXCOORD6;
  float4 position : SV_Position;
  bool front_face : SV_IsFrontFace;
};

float4 main(PSInputPort input, out uint coverage : SV_Coverage) : SV_Target0 {
  float4 r0 = input.v0, r1 = input.v1, r2 = input.v2, r3 = input.v3, r4 = input.v4, r5 = input.v5, r6 = input.v6;
  float4 r7 = 0.0, r8 = 0.0, r9 = 0.0, r10 = 0.0, r11 = 0.0, r12 = 0.0, r13 = 0.0, r14 = 0.0;
  float4 r15 = 0.0;
  float4 o = 0.0;
  float ps = 0.0;
  bool p0 = false;
  r7.xy = GuestPixelPosition(input.position, input.front_face);

  { float4 v = (r0.yyyx * C9.yyyx + C9.wwwz); r0.zw = v.zw; }  // 14
  { float4 v = (r0.yxxx * C8.yxxx + C8.wzzz); r8.xy = v.xy; }  // 15
  { float4 v = (r0.yyyx * C10.yyyx + C10.wwwz); r8.zw = v.zw; }  // 16
  { float4 t = TF2(r8.wz); r11.z = t.x; r11.w = t.y; }  // 17
  { float4 t = TF0(r8.yx); r8.x = t.w; r8.y = t.x; r8.z = t.y; r8.w = t.z; }  // 18
  float3 sp_albedo = r8.yzw * r8.yzw;  // Sparrow: colour map, linear
  { float4 t = TF1(r0.wz); r9.x = t.x; r9.y = t.y; r9.z = t.z; }  // 19
  { float4 v = dot(r1.zxy, r1.zxy).xxxx; r1.w = v.w; }  // 20
  { float4 v = (-r2.xyzz + C19.xyzz); r12.xyz = v.xyz; }  // 21
  { float4 v = (r8.wzyy * r8.wzyy); float s = r9.x * r9.x; r10.xyz = v.xyz; r11.x = s; ps = s; }  // 22
  { float4 v = dot(r12.zxy, r12.zxy).xxxx; float s = r9.y * r9.y; r0.z = v.z; r11.y = s; ps = s; }  // 23
  { float4 v = (r11.wzzz * C254.yyyy + C255.zzzz); r9.xy = v.xy; }  // 24
  { float4 v = (dot(r9.yx, r9.yx) + C255.y).xxxx; r0.w = v.w; }  // 25
  { float4 v = (r9.xxxx * r4.zzxy); float s = r9.z * r9.z; r8.yzw = v.yzw; r11.z = s; ps = s; }  // 26
  { float4 v = (r9.yyyy * r3.zzxy + r8.yyzw); r8.yzw = v.yzw; }  // 27
  { float4 v = (-r0.wwww + C255.xxxx); float s = rsqrt(abs(r1.w)); r0.w = v.w; r1.w = s; ps = s; }  // 28
  { float4 v = (r1.wwww * r1.zyxx); float s = sqrt(abs(r0.w)); r9.xyz = v.xyz; r0.w = s; ps = s; }  // 29
  { float4 v = (r9.xyzz * r0.wwww + r8.ywzz); r9.xyz = v.xyz; }  // 30
  { float4 v = dot(r9.xzy, r9.xzy).xxxx; float s = rsqrt(abs(r0.z)); r0.w = v.w; r1.w = s; ps = s; }  // 31
  { float4 v = (r12.xxyz * r1.wwww); float s = rsqrt(abs(r0.w)); r8.yzw = v.yzw; r0.w = s; ps = s; }  // 32
  { float4 v = (r9.xyzz * r0.wwww); float s = sqrt(abs(r0.z)); r9.xyz = v.xyz; r0.z = s; ps = s; }  // 33
  if (XeBool(128)) {
    { float s = r8.x * r8.x; r0.w = s; ps = s; }  // 34
    { float s = rcp(r0.w); r0.w = s; ps = s; }  // 35
    { float4 v = (r10.xyzz * r0.wwww); r10.xyz = v.xyz; }  // 36
  }
  { float4 v = (abs(r7.xyyy) * C0.zwww + C0.xyyy); r7.xy = v.xy; }  // 37
  { float4 t = TF8(r7.xy); r7.w = t.x; }  // 38
#if SPARROW
  // The normal is ready (r9, instruction 33): the sun map's shadow joins the
  // game's screen shadow.
  if (SparrowActive()) r7.w = SparrowSunOr(r7.w, input.v2.xyz, r9.zyx);
#endif
  { float4 v = (-C22.xyzz + C255.xxxx); r15.xyz = v.xyz; }  // 39
  { float4 v = (r10.zyxx * C27.wwww); r12.xyz = v.xyz; }  // 40
  { float4 v = dot(r5.zxy, r5.zxy).xxxx; float s = log2(abs(r6.x)); r6.w = v.w; r6.x = s; ps = s; }  // 41
  { float4 v = dot(r9.xzy, C80.zxy).xxxx; float s = log2(abs(r6.y)); r0.w = v.w; r6.y = s; ps = s; }  // 42
  { float4 v = saturate(dot(r9.xzy, C80.zxy).xxxx); float s = log2(abs(r6.z)); r7.x = v.x; r6.z = s; ps = s; }  // 43
  { float4 v = (r0.wwww + r0.wwww); float s = rsqrt(abs(r6.w)); r0.w = v.w; r6.w = s; ps = s; }  // 44
  { float4 v = (-r9.xyzz * r0.wwww + C80.zyxx); r13.xyz = v.xyz; }  // 45
  { float4 v = (r6.wwww * r5.zyxx); float s = saturate(C23.w * r7.x); r5.xyz = v.xyz; r0.w = s; ps = s; }  // 46
  { float4 v = saturate(dot(r5.xzy, r9.xzy).xxxx); float s = C21.w * r6.x; r7.z = v.z; r1.w = s; ps = s; }  // 47
  { float4 v = saturate(dot(-r8.wyz, r13.xzy).xxxx); float s = C21.w * r6.y; r2.w = v.w; r6.w = s; ps = s; }  // 48
  { float4 v = (r2.wwww * r2.wwww); float s = C21.w * r6.z; r2.w = v.w; r6.z = s; ps = s; }  // 49
  { float4 v = (r2.wwww * r2.wwww); float s = exp2(r1.w); r6.x = v.x; r5.x = s; ps = s; }  // 50
  { float4 v = (r0.wwww * r6.xxxx); float s = exp2(r6.w); r7.y = v.y; r5.y = s; ps = s; }  // 51
  { float4 v = (r7.zyxx * r7.zwww); float s = exp2(r6.z); r6.xyw = v.xyw; r5.z = s; ps = s; }  // 52
  { float4 v = (r5.xyzz * C21.xyzz); float s = C87.x * r6.w; r14.xyz = v.xyz; r13.x = s; ps = s; }  // 53
  { float4 v = (r6.yyyy * C87.xyzz); float s = C87.y * r6.w; r7.xyz = v.xyz; r13.y = s; ps = s; }  // 54
  { float4 v = (r6.xxxx * r15.xyzz + C22.xyzz); r5.xyz = v.xyz; }  // 55
  { float4 v = (r14.xyzz * r5.xyzz + C20.xyzz); r5.xyz = v.xyz; }  // 56
  float sky_vis = -1.0;
#if SPARROW
  if (SparrowActive()) r5.xyz = SparrowAmbient(r5.xyz, input.v2.xyz, r9.zyx, C87.xyz, sky_vis);
#endif
  float3 ambient = r5.xyz;  // Sparrow: the ambient light
  { float4 v = (r11.xzyy * r7.xzyy); float s = C87.z * r6.w; r7.xyz = v.xyz; r13.z = s; ps = s; }  // 57
#if SPARROW
  if (SparrowActive()) r7.xyz = 0.0;  // Sparrow's specular replaces the game's
#endif
  { float4 v = (r13.xyzz * r10.zyxx + r7.xzyy); r6.xyz = v.xyz; }  // 58
  { float4 v = (r12.xyzz * r5.xyzz + r6.xyzz); r5.xyz = v.xyz; }  // 59
#if SPARROW
  if (SparrowActive()) {
    float3 sl[SPARROW_LIGHTS_DECL], sc[SPARROW_LIGHTS_DECL];
    [unroll] for (uint k = 0; k < SPARROW_LIGHTS_DECL; ++k) { sl[k] = 0.0; sc[k] = 0.0; }
    sl[0] = normalize(C80.xyz);
    sc[0] = C87.xyz * r7.w;
    float3 add = SparrowLitSpecular(r9.zyx, r8.yzw, sl, sc, 1u, r11.xyz, sp_albedo,
                                    ambient * C27.w);
    r5.xyz = SparrowDebug() == 2 ? add : r5.xyz + add;
  }
#endif
  if (XeBool(133)) {
    { float4 t = TF13(r0.xy); r6.x = t.x; r6.y = t.y; r6.z = t.z; }  // 60
    { float4 v = (r6.xyzz * r6.xyzz); r6.xyz = v.xyz; }  // 61
    { float4 v = (r6.xyzz * C24.zzzz + r5.xyzz); r5.xyz = v.xyz; }  // 62
  }
  if (XeBool(134)) {
    { float4 v = dot(-r8.wyz, r9.xzy).xxxx; r6.x = v.x; }  // 63
    { float s = r6.x + r6.x; r6.x = s; ps = s; }  // 64
    { float4 v = (-r9.xzyy * r6.xxxx + -r8.wyzz); r6.xyw = v.xyw; }  // 65
    { float4 v = (r6.yyyy * r3.zxyy); r0.xyw = v.xyw; }  // 66
    { float4 v = (r6.xxxx * r1.zxyy + r0.xyww); r6.xyz = v.xyz; }  // 67
    { float4 v = (-r6.wwww * r4.yyyy + -r6.zzzz); r6.z = v.z; }  // 68
  }
  if (XeBool(134)) {
    { float4 v = (r6.wwww * r4.xzzz + r6.yxxx); r6.xy = v.xy; }  // 69
    { float4 v = XeCube(r6.xyz); r6.xyzw = v.xyzw; }  // 70
    { float4 v = max(r6.wwww, r6.wwww); float s = rcp(abs(r6.z)); r0.w = v.w; r0.x = s; ps = s; }  // 71
    { float4 v = (r6.yxxx * r0.xxxx + C255.wwww); r0.xy = v.xy; }  // 72
    { float4 t = TF14(r0.xyw); r6.x = t.x; r6.y = t.y; r6.z = t.z; }  // 73
    { float4 v = (r6.xyzz * r6.xyzz); r6.xyz = v.xyz; }  // 74
  }
  if (XeBool(134)) {
    { float4 v = (r11.xyzz * r6.xyzz + r5.xyzz); r5.xyz = v.xyz; }  // 75
  }
  { float4 v = (r2.xyzz + -C19.xyzz); r0.xyw = v.xyw; }  // 76
  { float4 v = (r0.wwww >= 0.0 ? C255.yxxx : C255.xyyy); r3.xw = v.xw; }  // 77
  { float4 v = (-abs(r3.wwww) >= 0.0 ? r2.xyyy : C19.xyyy); r6.xy = v.xy; }  // 78
  { float4 v = (r6.xyyy * C74.xyyy + C74.zwww); r6.xy = v.xy; }  // 79
  { float4 t = TF12(r6.xy); r6.y = t.x; }  // 80
  { float4 v = (-C19.zzzz + C76.yyyy); float s = C76.x * r6.y; r6.z = v.z; r6.x = s; ps = s; }  // 81
  { float4 v = (r6.zzzz + r6.xxxx); float s = rcp(r0.w); r6.z = v.z; r6.y = s; ps = s; }  // 82
  { float4 v = (r6.zzzz * r6.yyyy); r6.y = v.y; }  // 83
  { float4 v = float4(C255.xxxx > r6.yyyy); float s = (r6.y >= 0.0 ? 1.0 : 0.0); r3.y = v.y; r3.z = s; ps = s; }  // 84
  { float4 v = (r5.xyzz * C49.xyzz); float s = max(r3.y, r3.y); r1.xyz = v.xyz; ps = s; }  // 85
  { float4 v = (abs(r3.xxxx) + r3.zzzz); float s = abs(r3.w) + ps; r6.w = v.w; r6.z = s; ps = s; }  // 86
  { float4 v = float4(r6.zzzw != C255.yyyy); r6.zw = v.zw; }  // 87
  { float s = r6.w * r6.z; r6.z = s; ps = s; }  // 88
  { float4 v = (r6.xxxx + C76.yyyy); bool pn = r6.z == 0.0; float s = pn ? 0.0 : 1.0; r6.x = v.x; p0 = pn; ps = s; }  // 89
  if (!p0) {
    if (!p0) { float4 v = (r3.xyyy * r3.zwww); r3.xy = v.xy; }  // 90
    if (!p0) { float4 v = (r6.yyyy * r0.xxyw + C19.xxyz); r6.yzw = v.yzw; }  // 91
    if (!p0) { float4 v = (r3.yyyy == 0.0 ? r2.xyzz : r6.yzww); r0.xyw = v.xyw; }  // 92
    if (!p0) { float4 v = (r3.xxxx == 0.0 ? C19.xyzz : r6.yzww); r2.xyz = v.xyz; }  // 93
    if (!p0) { float4 v = (r2.xyyy * C73.xyyy); r3.xy = v.xy; }  // 94
    if (!p0) { float4 v = (r0.yyyx * C73.yyyx); r3.zw = v.zw; }  // 95
  }
  if (!p0) {
    if (!p0) { float4 v = (r3.xyzw + C73.zwwz); r3.xyzw = v.xyzw; }  // 96
    if (!p0) { float4 v = (r3.yyxx + r3.zzww); r6.yz = v.yz; }  // 97
    if (!p0) { float4 v = (r6.zzyy * C254.xxxx); r6.yz = v.yz; }  // 98
    if (!p0) { float4 t = TF11(r3.xy); r3.z = t.x; }  // 99
    if (!p0) { float4 t = TF11(r6.yz); r3.w = t.x; }  // 100
  }
  if (!p0) {
    if (!p0) { float4 v = (C75.xxxx * C254.xxxx); r6.w = v.w; }  // 101
    if (!p0) { float4 v = (-C75.yyyy + C255.xxxx); r2.w = v.w; }  // 102
    if (!p0) { float4 v = (r6.xxxx + -r2.zzzz); r6.y = v.y; }  // 103
    if (!p0) { float4 v = (r0.xyww + -r2.xyzz); float s = max(r6.x, r6.x); r2.xyz = v.xyz; ps = s; }  // 104
    if (!p0) { float4 v = dot(r2.zxy, r2.zxy).xxxx; float s = -r0.w + ps; r6.x = v.x; r6.z = s; ps = s; }  // 105
    if (!p0) { float4 v = saturate((r6.yzzz * C76.wwww)); r3.xy = v.xy; }  // 106
  }
  if (!p0) {
    if (!p0) { float4 v = (r3.xxzz + r3.yyww); float s = sqrt(abs(r6.x)); r2.yz = v.yz; r2.x = s; ps = s; }  // 107
    if (!p0) { float4 v = (r2.xxzz * C254.xxxx); r6.yz = v.yz; }  // 108
    if (!p0) { float4 v = (r6.zyww * r2.wyzz); r6.xyz = v.xyz; }  // 109
    if (!p0) { float4 v = (r6.xxxx + C75.yyyy); float s = r6.y - r6.z; r6.x = v.x; r6.y = s; ps = s; }  // 110
    if (!p0) { float4 v = (r6.yyyy * r6.xxxx); r6.x = v.x; }  // 111
    if (!p0) { float4 v = max(r6.xxxx, C255.yyyy); r6.x = v.x; }  // 112
  }
  if (!p0) {
    if (!p0) { float s = C76.z * r6.x; r6.x = s; ps = s; }  // 113
    if (!p0) { float s = exp2(r6.x); r6.y = s; ps = s; }  // 114
    if (!p0) { float s = C255.x - (r6.y); r6.x = s; ps = s; }  // 115
    if (!p0) { float4 v = (r6.xxxx * C72.zyyx); r6.xzw = v.xzw; }  // 116
    if (!p0) { float4 v = (r6.wzzx * C28.yyyy); r6.xzw = v.xzw; }  // 117
    if (!p0) { float4 v = (r1.xyzz * r6.yyyy + r6.xzww); r1.xyz = v.xyz; }  // 118
  }
  { float s = -C67.x - (-r0.z); r6.x = s; ps = s; }  // 119
  { bool pn = r6.x > 0.0; float s = pn ? 0.0 : 1.0; p0 = pn; ps = s; }  // 120
  if (p0) {
    if (p0) { float4 v = saturate(dot(-r8.wyz, C66.zxy).xxxx); float s = C67.w * r6.x; r6.y = v.y; r0.x = s; ps = s; }  // 121
    if (p0) { float4 t = TF4(r6.y); r6.y = t.x; r6.z = t.y; r6.w = t.z; }  // 122
    if (p0) { float4 t = TF5(r0.x); r0.x = t.x; r0.y = t.y; r0.z = t.z; }  // 123
    if (p0) { float4 v = (-r0.xyzz + C255.xxxx); r2.xyz = v.xyz; }  // 124
    if (p0) { float4 v = (r6.yyzw + -C68.xxyz); float s = saturate(C67.z * r6.x); r6.yzw = v.yzw; r6.x = s; ps = s; }  // 125
    if (p0) { float4 v = (r6.xxxx * r6.wzyy + C68.zyxx); r6.xyz = v.xyz; }  // 126
  }
  if (p0) {
    if (p0) { float4 v = (r2.xyzz * C28.yyyy); r2.xyz = v.xyz; }  // 127
    if (p0) { float4 v = (r2.xyzz * r6.zyxx + -r1.xyzz); r6.xyz = v.xyz; }  // 128
    if (p0) { float4 v = (r0.xyzz * r1.xyzz + r6.xyzz); r6.xyz = v.xyz; }  // 129
    if (p0) { float4 v = (r6.xyzz * C28.xxxx + r1.xyzz); r1.xyz = v.xyz; }  // 130
  }
  { float4 v = (C20.wwww * C26.xyzz); r6.xyz = v.xyz; }  // 131
  { float4 v = (r6.xyzz * r1.xyzz); float s = C26.w * r8.x; o.xyz = v.xyz; o.w = s; ps = s; }  // 132

#if SPARROW
  if (SparrowDebug() == 3) o.xyz = SparrowVisDebug(sky_vis);
#endif
  AlphaTest(o.w);
  coverage = AlphaToMask(o.w, input.position.xy);
  return o * xe_color_exp_bias.x;
}
