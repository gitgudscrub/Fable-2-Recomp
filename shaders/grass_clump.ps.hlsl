// Fable II grass clumps and tall grass (sun only), pixel shader
// A7E45D07F5CF6627. Built only for Project Sparrow (tools/shaders/build_replace.py
// --sparrow).
//
// A literal port of the game's Xenos microcode, generated by
// tools/shaders/ucode_port.py (comments give the ucode instruction numbers;
// reading notes in xe_common.hlsli). Sparrow: the sun shadow map joins the
// game's screen shadow (tf8), and the ambient gets the open sky and the sun's
// bounce from the ground grid (SparrowFoliageAmbient).

#define XE_FLOAT_CONSTANTS 13
#define XE_DESCRIPTOR_INDICES 4
#include "xe_common.hlsli"
#if SPARROW
#include "sparrow_common.hlsli"
#endif

#define C0 K[0]
#define C8 K[1]
#define C15 K[2]
#define C19 K[3]
#define C20 K[4]
#define C28 K[5]
#define C50 K[6]
#define C66 K[7]
#define C67 K[8]
#define C68 K[9]
#define C80 K[10]
#define C87 K[11]
#define C255 K[12]

// Texture bindings of this shader, in the translator's order.
#define TF8(uv) Fetch(8, 0, uv, false)
#define TF0(uv) Fetch(0, 1, uv, false)
#define TF4(x) Fetch(4, 2, float2(x, 0.0), true)
#define TF5(x) Fetch(5, 3, float2(x, 0.0), true)
#define TF10(uv) Fetch(10, 4, uv, false)

struct PSInputPort {
  float4 v0 : TEXCOORD0;
  float4 v1 : TEXCOORD1;
  float4 v2 : TEXCOORD2;
  float4 v3 : TEXCOORD3;
  centroid float4 v4 : TEXCOORD4;
  float4 position : SV_Position;
  bool front_face : SV_IsFrontFace;
};

float4 main(PSInputPort input, out uint coverage : SV_Coverage) : SV_Target0 {
  float4 r0 = input.v0, r1 = input.v1, r2 = input.v2, r3 = input.v3, r4 = input.v4;
  float4 r5 = 0.0, r6 = 0.0, r7 = 0.0;
  float4 o = 0.0;
  float ps = 0.0;
  bool p0 = false;
  r5.xy = GuestPixelPosition(input.position, input.front_face);

  { float4 v = (r0.yxxx * C8.yxxx + C8.wzzz); r0.xw = v.xw; }  // 5
  { float4 v = (abs(r5.xxyy) * C0.zzww + C0.xxyy); r0.yz = v.yz; }  // 6
  { float4 t = TF8(r0.yz); r6.x = t.x; }  // 7
#if SPARROW
  if (SparrowActive()) r6.x = SparrowSunOrVolume(r6.x, input.v2.xyz);
#endif
  { float4 t = TF0(r0.wx); r5.x = t.x; r5.y = t.y; r5.z = t.z; r5.w = t.w; }  // 8
  { float4 v = (-r2.zyxx + C19.zyxx); r2.xyz = v.xyz; }  // 9
  { float4 v = dot(r2.xzy, r2.xzy).xxxx; r4.w = v.w; }  // 10
  { float4 v = saturate(max(r3.wwww, r3.wwww)); float s = rsqrt(abs(r4.w)); r0.x = v.x; r1.w = s; ps = s; }  // 11
  { float4 v = dot(r1.zxy, r1.zxy).xxxx; float s = sqrt(abs(r4.w)); r0.w = v.w; r4.w = s; ps = s; }  // 12
  { float4 v = (r2.xyzz * r1.wwww); float s = rsqrt(abs(r0.w)); r2.xyz = v.xyz; r0.w = s; ps = s; }  // 13
  { float4 v = (r5.xyzw * r5.xyzw); r7.xyzw = v.xyzw; }  // 14
  { float4 v = (r0.wwww * r1.zyxx); r1.xyz = v.xyz; }  // 15
  { float4 v = (-r1.zyxx + r3.xyzz); r3.xyz = v.xyz; }  // 16
  { float4 v = (r3.zyxx * r0.xxxx + r1.xyzz); r1.xyz = v.xyz; }  // 17
  { float4 v = dot(r1.xzy, r1.xzy).xxxx; float s = rcp(r7.w); r0.x = v.x; r0.w = s; ps = s; }  // 18
  { float4 v = (r7.xyzz * r0.wwww); float s = rsqrt(abs(r0.x)); r3.xyz = v.xyz; r0.x = s; ps = s; }  // 19
  { float4 v = (r1.xyzz * r0.xxxx); r1.xyz = v.xyz; }  // 20
  { float4 v = saturate(dot(r1.xzy, C80.zxy).xxxx); r0.x = v.x; }  // 21
  { float4 v = (r0.xxxx * r6.xxxx); r6.y = v.y; }  // 22
  { float4 v = (r6.yyyx * C87.yyzx); r1.yzw = v.yzw; }  // 23
  { float4 v = (r1.wwww * r0.xxxx); float s = -C67.x - (-r4.w); r1.x = v.x; r0.x = s; ps = s; }  // 24
  { float4 v = (r3.xyzz * r1.xyzz); bool pn = r0.x > 0.0; float s = pn ? 0.0 : 1.0; r1.xyz = v.xyz; p0 = pn; ps = s; }  // 25
  float sky_vis = -1.0;
#if SPARROW
  float3 sp_delta = 0.0;  // Sparrow's change to the ambient (sparrow_debug 2)
  if (SparrowActive()) { float3 a0 = r4.xyz; r4.xyz = SparrowFoliageAmbient(r4.xyz, input.v2.xyz, C87.xyz, sky_vis); sp_delta = r4.xyz - a0; }
#endif
  { float4 v = (r3.xyzz * r4.xyzz + r1.xyzz); r4.xyz = v.xyz; }  // 26
  if (p0) {
    if (p0) { float4 v = saturate(dot(-r2.xzy, C66.zxy).xxxx); float s = C67.w * r0.x; r1.x = v.x; r0.w = s; ps = s; }  // 27
    if (p0) { float4 t = TF4(r1.x); r1.x = t.x; r1.y = t.y; r1.z = t.z; }  // 28
    if (p0) { float4 t = TF5(r0.w); r2.x = t.x; r2.y = t.y; r2.z = t.z; }  // 29
    if (p0) { float4 v = (-r2.xyzz + C255.xxxx); r3.xyz = v.xyz; }  // 30
    if (p0) { float4 v = (r1.xyzz + -C68.xyzz); float s = saturate(C67.z * r0.x); r1.xyz = v.xyz; r0.x = s; ps = s; }  // 31
    if (p0) { float4 v = (r0.xxxx * r1.zyxx + C68.zyxx); r1.xyz = v.xyz; }  // 32
  }
  if (p0) {
    if (p0) { float4 v = (r3.zyxx * C28.yyyy); r3.xyz = v.xyz; }  // 33
    if (p0) { float4 v = (r3.xyzz * r1.xyzz + -r4.zyxx); r1.xyz = v.xyz; }  // 34
    if (p0) { float4 v = (r4.zyxx * r2.zyxx + r1.xyzz); r1.xyz = v.xyz; }  // 35
    if (p0) { float4 v = (r1.zyxx * C28.xxxx + r4.xyzz); r4.xyz = v.xyz; }  // 36
  }
  { float4 v = (r0.yyzz * C50.xxyy); float s = -C15.z - (-r4.w); r0.yz = v.yz; r0.x = s; ps = s; }  // 37
  { float4 t = TF10(r0.yz); r4.w = t.w; }  // 38
  { float4 v = (r4.xyzz * C20.wwww); o.xyz = v.xyz; }  // 39
  { float4 v = saturate((-r0.xxxx * C15.yyyy + C255.xxxx)); r4.x = v.x; }  // 40
  { float4 v = (r4.xxxx + r4.wwww); r4.x = v.x; }  // 41
  { float4 v = float4(r4.xxxx >= C255.xxxx); r4.x = v.x; }  // 42
  { float4 v = (r4.xxxx * r5.wwww); o.w = v.w; }  // 43

#if SPARROW
  if (SparrowDebug() == 2) o.xyz = abs(sp_delta);
  if (SparrowDebug() == 3) o.xyz = SparrowVisDebug(sky_vis);
#endif
  AlphaTest(o.w);
  coverage = AlphaToMask(o.w, input.position.xy);
  return o * xe_color_exp_bias.x;
}
