// Fable II bushes and hedges (two lights + the sun shadow map tf9), pixel shader
// E99F4ACC7A3C78B4. Built only for Project Sparrow (tools/shaders/build_replace.py
// --sparrow).
//
// A literal port of the game's Xenos microcode, generated by
// tools/shaders/ucode_port.py (comments give the ucode instruction numbers;
// reading notes in xe_common.hlsli). Sparrow: the sun shadow map joins the
// game's screen shadow (tf8), and the ambient gets the open sky and the sun's
// bounce from the ground grid (SparrowFoliageAmbient).

#define XE_FLOAT_CONSTANTS 28
#define XE_DESCRIPTOR_INDICES 5
#include "xe_common.hlsli"
#if SPARROW
#include "sparrow_common.hlsli"
#endif

#define C0 K[0]
#define C8 K[1]
#define C15 K[2]
#define C19 K[3]
#define C20 K[4]
#define C28 K[5]
#define C32 K[6]
#define C33 K[7]
#define C34 K[8]
#define C35 K[9]
#define C48 K[10]
#define C50 K[11]
#define C66 K[12]
#define C67 K[13]
#define C68 K[14]
#define C80 K[15]
#define C81 K[16]
#define C87 K[17]
#define C88 K[18]
#define C94 K[19]
#define C96 K[20]
#define C98 K[21]
#define C99 K[22]
#define C105 K[23]
#define C107 K[24]
#define C112 K[25]
#define C114 K[26]
#define C255 K[27]

// Texture bindings of this shader, in the translator's order.
#define TF8(uv) Fetch(8, 0, uv, false)
#define TF0(uv) Fetch(0, 1, uv, false)
#define TF9(uv) Fetch(9, 2, uv, false)
#define TF9_OFF(uv, ox, oy) FetchOffset(9, 2, uv, int2(ox, oy))
#define TF4(x) Fetch(4, 3, float2(x, 0.0), true)
#define TF5(x) Fetch(5, 4, float2(x, 0.0), true)
#define TF10(uv) Fetch(10, 5, uv, false)

struct PSInputPort {
  float4 v0 : TEXCOORD0;
  float4 v1 : TEXCOORD1;
  float4 v2 : TEXCOORD2;
  float4 v3 : TEXCOORD3;
  centroid float4 v4 : TEXCOORD4;
  float4 position : SV_Position;
  bool front_face : SV_IsFrontFace;
};

float4 main(PSInputPort input, out uint coverage : SV_Coverage) : SV_Target0 {
  float4 r0 = input.v0, r1 = input.v1, r2 = input.v2, r3 = input.v3, r4 = input.v4;
  float4 r5 = 0.0, r6 = 0.0, r7 = 0.0, r8 = 0.0, r9 = 0.0, r10 = 0.0, r11 = 0.0;
  float4 o = 0.0;
  float ps = 0.0;
  bool p0 = false;
  r5.xy = GuestPixelPosition(input.position, input.front_face);

  { float4 v = (r0.yxxx * C8.yxxx + C8.wzzz); r0.xy = v.xy; }  // 9
  { float4 v = (abs(r5.xyyy) * C0.zwww + C0.xyyy); r6.xy = v.xy; }  // 10
  { float4 t = TF8(r6.xy); r4.w = t.x; }  // 11
#if SPARROW
  if (SparrowActive()) r4.w = SparrowSunOrVolume(r4.w, input.v2.xyz);
#endif
  { float4 t = TF0(r0.yx); r0.x = t.x; r0.y = t.w; r0.z = t.y; r0.w = t.z; }  // 12
  { float4 v = (-r2.zyxx + C19.zyxx); r5.xyz = v.xyz; }  // 13
  { float4 v = dot(r1.zxy, r1.zxy).xxxx; r2.w = v.w; }  // 14
  { float4 v = (r0.xzwy * r0.xzwy); float s = saturate(max(r3.w, r3.w)); r7.xyzw = v.xyzw; r0.z = s; ps = s; }  // 15
  { float4 v = dot(r5.xzy, r5.xzy).xxxx; float s = rsqrt(abs(r2.w)); r1.w = v.w; r0.x = s; ps = s; }  // 16
  { float4 v = (r0.xxxx * r1.zyxx); float s = rsqrt(abs(r1.w)); r1.xyz = v.xyz; r0.x = s; ps = s; }  // 17
  { float4 v = (r5.xyzz * r0.xxxx); float s = rcp(r7.w); r5.xyz = v.xyz; r0.x = s; ps = s; }  // 18
  { float4 v = (r7.xyzz * r0.xxxx); float s = C255.y - (r4.w); r7.xyz = v.xyz; r4.w = s; ps = s; }  // 19
  { float4 v = (-r1.zyxx + r3.xyzz); float s = C112.x * r4.w; r3.xyz = v.xyz; r0.x = s; ps = s; }  // 20
  { float4 v = (r3.zyxx * r0.zzzz + r1.xyzz); r1.xyz = v.xyz; }  // 21
  { float4 v = dot(r1.xzy, r1.xzy).xxxx; float s = C112.y * r4.w; r2.w = v.w; r0.z = s; ps = s; }  // 22
  float sky_vis = -1.0;
#if SPARROW
  if (SparrowActive()) r4.xyz = SparrowFoliageAmbient(r4.xyz, input.v2.xyz, C87.xyz, sky_vis);
#endif
  { float4 v = (r7.xyzz * r4.xyzz); float s = rsqrt(abs(r2.w)); r3.xyz = v.xyz; r4.x = s; ps = s; }  // 23
  { float4 v = (r1.xyzz * r4.xxxx); float s = sqrt(abs(r1.w)); r1.xyz = v.xyz; r4.y = s; ps = s; }  // 24
  if (XeBool(135)) {
    { float4 v = (C255.xxxy == 0.0 ? r2.zxyy : C255.yyyy); r11.xyzw = v.xyzw; }  // 25
    { float4 v = dot(C32.zxyw, r11.xyzw).xxxx; float s = rcp(C48.x); r8.z = v.z; r8.x = s; ps = s; }  // 26
    { float4 v = dot(C35.zxyw, r11.xyzw).xxxx; float s = rcp(C48.y); r4.x = v.x; r8.y = s; ps = s; }  // 27
    { float4 v = dot(C33.zxyw, r11.xyzw).xxxx; float s = rcp(r4.x); r8.w = v.w; r4.x = s; ps = s; }  // 28
    { float4 v = (r8.xyzw * r4.xxxx); r10.xyzw = v.xyzw; }  // 29
    { float4 t = TF9(r10.zw); r9.x = t.x; }  // 30
  }
  if (XeBool(135)) {
    { float4 t = TF9_OFF(r10.zw, 0, 1); r9.y = t.x; }  // 31
    { float4 t = TF9_OFF(r10.zw, 1, 0); r9.z = t.x; }  // 32
    { float4 t = TF9_OFF(r10.zw, 1, 1); r9.w = t.x; }  // 33
    { float4 v = dot(C34.zxyw, r11.xyzw).xxxx; r4.z = v.z; }  // 34
    { float4 v = (r10.xxxy * r8.zzzw); r6.zw = v.zw; }  // 35
    { float4 v = frac(r6.wwzz); float s = max(r4.z, r4.z); r8.yz = v.yz; ps = s; }  // 36
  }
  if (XeBool(135)) {
    { float4 v = (-r8.yyyy + C255.yyyy); float s = r4.x * ps; r8.x = v.x; r8.w = s; ps = s; }  // 37
    { float4 v = (-r8.wzzz + C255.yyyy); r4.xz = v.xz; }  // 38
    { float4 v = float4(r4.xxxx >= r9.xyzw); r9.xyzw = v.xyzw; }  // 39
    { float4 v = (r4.zzzz * r9.xyyy); r9.xy = v.xy; }  // 40
    { float4 v = (r9.zzzw * r8.zzzz); r9.zw = v.zw; }  // 41
    { float4 v = dot(r9.wyxz, r8.yyxx).xxxx; r4.x = v.x; }  // 42
  }
  if (XeBool(135)) {
    { float s = C255.y - (r4.x); r4.x = s; ps = s; }  // 43
    { float4 v = (r4.xxxx * C114.xyyy); r4.xz = v.xz; }  // 44
    { float4 v = max(r0.xzzz, r4.xzzz); r0.xz = v.xz; }  // 45
  }
  { float4 v = (-r2.xyzz * C80.wwww + C80.xyzz); r9.xyz = v.xyz; }  // 46
  { float4 v = (-r2.xyzz * C81.wwww + C81.xyzz); r2.xyz = v.xyz; }  // 47
  { float4 v = dot(r2.zxy, r2.zxy).xxxx; r0.w = v.w; }  // 48
  { float4 v = dot(r9.zxy, r9.zxy).xxxx; float s = rsqrt(abs(r0.w)); r1.w = v.w; r4.x = s; ps = s; }  // 49
  { float4 v = (r2.xyzz * r4.xxxx); float s = rsqrt(abs(r1.w)); r8.xyz = v.xyz; r4.x = s; ps = s; }  // 50
  { float4 v = (r9.xyyz * r4.xxxx); r4.xzw = v.xzw; }  // 51
  { float4 v = saturate(dot(r1.xzy, r4.wxz).xxxx); float s = sqrt(abs(r1.w)); r2.x = v.x; r2.z = s; ps = s; }  // 52
  { float4 v = saturate(dot(r1.xzy, r8.zxy).xxxx); float s = sqrt(abs(r0.w)); r2.y = v.y; r2.w = s; ps = s; }  // 53
  { float4 v = saturate((-r2.wwwz * C96.yyyx + C255.yyyy)); r2.zw = v.zw; }  // 54
  { float4 v = dot(r4.wxz, C98.zxy).xxxx; r4.x = v.x; }  // 55
  { float4 v = dot(r8.zxy, C99.zxy).xxxx; r4.z = v.z; }  // 56
  { float4 v = (r4.xzzz + -C105.xyyy); float s = C255.y - (r0.x); r4.xz = v.xz; r1.x = s; ps = s; }  // 57
  { float4 v = saturate((r4.xxxz * C107.xxxy)); float s = C255.y - (r0.z); r1.zw = v.zw; r1.y = s; ps = s; }  // 58
  { float4 v = (r1.xywz * r2.xyzw); r1.xyzw = v.xyzw; }  // 59
  { float4 v = (r1.zwww + C255.zzzz); r4.xz = v.xz; }  // 60
  { float4 v = (r4.xzzz * C94.yxxx + C255.yyyy); r4.xz = v.xz; }  // 61
  { float4 v = (r1.xxxy * r4.zzzx); float s = -C67.x - (-r4.y); r4.zw = v.zw; r4.x = s; ps = s; }  // 62
  { float4 v = (r4.wwww * C88.xyyz); bool pn = r4.x > 0.0; float s = pn ? 0.0 : 1.0; r0.xzw = v.xzw; p0 = pn; ps = s; }  // 63
  { float4 v = (r4.zzzz * C87.xyyz + r0.xzzw); r0.xzw = v.xzw; }  // 64
  { float4 v = (r7.xyyz * r0.xzzw + r3.xyyz); r0.xzw = v.xzw; }  // 65
  if (p0) {
    if (p0) { float4 v = saturate(dot(-r5.xzy, C66.zxy).xxxx); float s = C67.w * r4.x; r4.w = v.w; r4.z = s; ps = s; }  // 66
    if (p0) { float4 t = TF4(r4.w); r3.x = t.x; r3.y = t.y; r3.z = t.z; }  // 67
    if (p0) { float4 t = TF5(r4.z); r1.x = t.x; r1.y = t.y; r1.z = t.z; }  // 68
    if (p0) { float4 v = (-r1.xyzz + C255.yyyy); r2.xyz = v.xyz; }  // 69
    if (p0) { float4 v = (r3.xyzz + -C68.xyzz); float s = saturate(C67.z * r4.x); r3.xyz = v.xyz; r4.x = s; ps = s; }  // 70
    if (p0) { float4 v = (r4.xxxx * r3.zyyx + C68.zyyx); r4.xzw = v.xzw; }  // 71
  }
  if (p0) {
    if (p0) { float4 v = (r2.zyxx * C28.yyyy); r2.xyz = v.xyz; }  // 72
    if (p0) { float4 v = (r2.xyyz * r4.xzzw + -r0.wzzx); r4.xzw = v.xzw; }  // 73
    if (p0) { float4 v = (r0.wzzx * r1.zyyx + r4.xzzw); r4.xzw = v.xzw; }  // 74
    if (p0) { float4 v = (r4.wzzx * C28.xxxx + r0.xzzw); r0.xzw = v.xzw; }  // 75
  }
  { float4 v = (r6.xyyy * C50.xyyy); float s = -C15.z - (-r4.y); r4.xz = v.xz; r4.y = s; ps = s; }  // 76
  { float4 t = TF10(r4.xz); r4.x = t.w; }  // 77
  { float4 v = (r0.xzww * C20.wwww); o.xyz = v.xyz; }  // 78
  { float4 v = saturate((-r4.yyyy * C15.yyyy + C255.yyyy)); r4.y = v.y; }  // 79
  { float4 v = (r4.yyyy + r4.xxxx); r4.x = v.x; }  // 80
  { float4 v = float4(r4.xxxx >= C255.yyyy); r4.x = v.x; }  // 81
  { float4 v = (r4.xxxx * r0.yyyy); o.w = v.w; }  // 82

#if SPARROW
  if (SparrowDebug() == 3) o.xyz = SparrowVisDebug(sky_vis);
#endif
  AlphaTest(o.w);
  coverage = AlphaToMask(o.w, input.position.xy);
  return o * xe_color_exp_bias.x;
}
