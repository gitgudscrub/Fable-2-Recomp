<Project Sdk="Microsoft.NET.Sdk">
  <!-- Creates the release signing key and signs update packages (.nupkg -> .nupkg.sig).
       The launcher verifies these with UpdateSignature.ReleasePublicKey. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sparrow-sign</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\launcher\Fable2.Launcher\UpdateSignature.cs" Link="UpdateSignature.cs" />
  </ItemGroup>
</Project>
